# Public site URL (canonical URLs, sitemap, metadataBase)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Backend API base URL (also allowed as a next/image host)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only. Must equal the backend's REVALIDATE_SECRET; the backend sends it
# in the x-revalidate-secret header to POST /api/revalidate.
REVALIDATE_SECRET=change-me
